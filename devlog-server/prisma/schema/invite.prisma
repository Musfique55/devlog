model Invite {
  id          String       @id @default(uuid())
  email       String
  token       String       @unique
  workspaceId String
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invite")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}
